# Lumia code and shared Codex tools. Perforce owns other project data.
/*
!/.gitignore
!/.gitattributes
!/README_CODE.ko.txt
!/Source/
!/Plugins/

# Plugin descriptors, assets and runtime files stay in Perforce.
/Plugins/**
!/Plugins/**/
!/Plugins/**/Source/
!/Plugins/**/Source/**


# Shared project skills, hooks and guides; no personal config.
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/.p4ignore
!/.agents/skills/planning-with-files/
!/.agents/skills/reviewed-feature-guide/
!/.agents/skills/lm-task-card/
!/.agents/skills/lm-daily-report/
!/.agents/skills/korean-writing-care/
!/.codex/
/.codex/*
!/.codex/hooks.json
!/.codex/hooks/
!/Docs/
/Docs/*
!/Docs/LMContext/
/.agents/**/__pycache__/
/.codex/**/__pycache__/
# Generated or private files must not enter Git, even below a source directory.
**/Intermediate/
**/Binaries/
**/Saved/
**/DerivedDataCache/
**/.vs/
**/.idea/
**/.vscode/
**/__pycache__/
**/.p4config
**/.p4config.*
**/p4config.txt
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.VC.db
*.VC.opendb
*.pyc
*.pdb
*.dll
*.exe
*.obj
*.uasset
*.umap
*.fbx
*.blend
*.psd

# Reviewed team rules are shared; generated working memory stays local everywhere.
!/AGENTS.md
**/.planning/
**/.lmcontext-local/
**/Saved/LMContext/
/task_plan.md
/findings.md
/progress.md
/MEMORY.md
# Context tooling overview and redistribution notices.
!/Readme.md
!/THIRD_PARTY_NOTICES.md
