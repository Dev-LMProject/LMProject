# Lumia code and shared Codex tools. Perforce owns other project data.
/*
!/.gitignore
!/.gitattributes
!/README_CODE.ko.txt
!/Source/
!/Plugins/

# Plugin descriptors, assets and runtime files stay in Perforce.
/Plugins/**
!/Plugins/**/
!/Plugins/**/Source/
!/Plugins/**/Source/**


# LMContext: version only the shared skill, hooks and guide; no personal config.
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/planning-with-files/
!/.codex/
/.codex/*
!/.codex/hooks.json
!/.codex/hooks/
!/Docs/
/Docs/*
!/Docs/LMContext/
/.agents/**/__pycache__/
/.codex/**/__pycache__/
# Generated or private files must not enter Git, even below a source directory.
**/Intermediate/
**/Binaries/
**/Saved/
**/DerivedDataCache/
**/.vs/
**/.idea/
**/.vscode/
**/__pycache__/
**/.p4config
**/.p4config.*
**/p4config.txt
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.VC.db
*.VC.opendb
*.pyc
*.pdb
*.dll
*.exe
*.obj
*.uasset
*.umap
*.fbx
*.blend
*.psd

# Reviewed team rules are shared; working memory stays local unless allowed below.
!/AGENTS.md
**/.planning/
**/.lmcontext-local/
**/Saved/LMContext/
/task_plan.md
/findings.md
/progress.md
/MEMORY.md

# User-requested HackingSystem planning records for this branch.
# Keep these rules and planning updates in separate documentation commits.
# Do not integrate those commits into other branches; select code commits only.
!/.planning/
/.planning/*
!/.planning/2026-11-06-lm-hacking-session-design/
/.planning/2026-11-06-lm-hacking-session-design/*
!/.planning/2026-11-06-lm-hacking-session-design/*.md

# Context tooling overview and redistribution notices.
!/Readme.md
!/THIRD_PARTY_NOTICES.md
