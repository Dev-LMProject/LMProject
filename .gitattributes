# Store source text consistently; build products and assets belong to Perforce.
* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.cs text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

